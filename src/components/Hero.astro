---
interface Action {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  actions?: Action[];
  role?: string;
  location?: string;
}

import { withBase } from "../utils/slugify";
import CharacterFollow from "./CharacterFollow.astro";

const isExternal = (path: string) => /^[a-z][a-z0-9+.-]*:/i.test(path) || path.startsWith('//');

const { title, description, actions = [], role, location } = Astro.props as Props;
---

<section class="flex flex-col justify-between" style="min-height: calc(100vh - (var(--grid-cell) / 2));">
  <div class="flex-1 flex flex-col pb-6 md:pb-10 lg:pb-0">
    <div class="flex-1 flex flex-col lg:flex-row lg:items-start gap-4 lg:gap-6">
      <!--
        Follows the cursor. On large screens the bust stands on the line above the info row
        (self-end, no gap below), so it doesn't float. On small screens it sits above the title
        and its cut-off bottom fades out instead.
      -->
      <CharacterFollow
        alt={`3D character of ${title}`}
        class="hero-photo order-1 lg:order-2 lg:self-end w-full max-w-md mx-auto lg:mx-0 lg:w-[24rem] xl:w-[28rem] 2xl:w-[34rem] lg:max-w-none shrink-0"
      />
      <div
        class="order-2 lg:order-1 flex-1 hero-letters text-[13vw] lg:text-[8vw] 2xl:text-[10vw] leading-[0.85] font-extrabold text-base-900 uppercase"
        aria-hidden="true"
      >
        {title}
      </div>
    </div>
  </div>

  <div class="max-w-360 mx-auto px-8 w-full mt-auto">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3 border-b pb-8 border-base-200 lg:border-t lg:pt-8">
      <div>
        {role && <h1 class="text-xs 2xl:text-lg text-base-900 font-bold uppercase">{role}</h1>}
      </div>

      <div class="md:col-span-1">
        {description && <p class="text-sm 2xl:text-xl text-base-600">{description}</p>}
        {location && <p class="text-sm text-base-600 mt-2">{location}</p>}
      </div>

      <div class="md:col-span-1 flex items-start md:justify-end">
        {actions.length > 0 && (
          <div class="mt-0 md:mt-0 flex flex-col md:flex-row md:items-start md:justify-end gap-3">
            {actions.map((action) => (
              isExternal(action.href) ? (
                <a
                  class="hero-action text-xs 2xl:text-lg text-base-900 font-bold uppercase inline-block px-4 py-2"
                  href={action.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {action.label}
                </a>
              ) : (
                <a
                  class="hero-action text-xs 2xl:text-lg text-base-900 font-bold uppercase inline-block px-4 py-2"
                  href={withBase(action.href)}
                >
                  {action.label}
                </a>
              )
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Module scripts run once; astro:page-load fires on the first load and after every page switch.
  let firstLoad = true;

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.hero-letters')) return;
    // On the first load, wait for the page curtain; after a page switch there is none.
    const delay = firstLoad && !document.documentElement.dataset.introSeen ? 0.7 : 0.1;
    firstLoad = false;

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' }, delay });

    tl.from('.hero-letters', { opacity: 0, y: 60, duration: 0.9 })
      .from('.hero-photo', { opacity: 0, x: 40, duration: 0.7 }, '-=0.5')
      .from('section .max-w-360 > div > div', { opacity: 0, y: 20, duration: 0.6, stagger: 0.1 }, '-=0.3');
  });
</script>
